      "value": "true",
      "note": "Fixes missing AC graphics."
    },
    {
      "id": "rpcs3.strict",
      "value": "true",
      "note": "Partially resolves flickering bloom."
    },
    {
      "id": "rpcs3.keyboard",
      "value": "Basic",
      "note": "Supports keyboard for multiplayer features."
    },
    {
      "id": "rpcs3.psn",
      "value": "RPCN",
      "note": "Login required when Network Status is set to Connected. <br/>Prevents the game from hanging on boot."
    }
