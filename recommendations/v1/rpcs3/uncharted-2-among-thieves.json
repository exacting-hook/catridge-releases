  "settings": [
    {
      "id": "video.anisotropic",
      "value": "off",
      "note": "Changing to anything other than Auto causes graphical issues."
    },
    {
      "id": "rpcs3.zcull_precise",
      "value": "true",
      "note": "Required for reflections and heat wave effects"
    },
    {
      "id": "rpcs3.zcull_relaxed",
      "value": "false",
      "note": "Required for reflections and heat wave effects"
    },
    {
      "id": "rpcs3.min_scalable",
      "value": "160",
      "note": "Fixes bloom artifacts when using Resolution scaling above 100%."
    },
    {
      "id": "rpcs3.wcb",
      "value": "true",
      "note": "Fixes some overly bright scenes."
    },
    {
      "id": "rpcs3.async_textures",
      "value": "true",
      "note": "Improves performance depending on the GPU. Causes graphical issues without Read Depth Buffers enabled."
    },
    {
      "id": "rpcs3.rdb",
      "value": "true",
      "note": "Fixes flickering. Required only if you are using Async Texture Streaming."
    }
  ],
