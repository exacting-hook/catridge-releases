    },
    {
      "id": "rpcs3.debug_console",
      "value": "true",
      "note": "Enable this if the game crashes on boot."
    },
    {
      "id": "rpcs3.wdb",
      "value": "true",
      "note": "Fixes broken graphics."
    },
    {
      "id": "rpcs3.vertex_cache_off",
      "value": "true",
      "note": "Fixes flickering in the main menu."
    }
  ],
  "patches": []
}
