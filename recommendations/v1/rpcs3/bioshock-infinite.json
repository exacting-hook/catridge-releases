  "serials": [
    "BLUS30629",
    "BLUS31117",
    "BLES01705",
    "BLJS10207",
    "NPEB01290",
    "NPUB31128",
    "NPJB00363"
  ],
  "settings": [
    {
      "id": "rpcs3.xfloat",
      "value": "Accurate",
      "note": "Fixes broken collision with ragdolls. Reduces performance."
    },
    {
      "id": "rpcs3.min_scalable",
      "value": "288",
      "note": "Fixes green artifacts and scales bloom when using Resolution Scaling."
    },
    {
      "id": "rpcs3.wcb",
      "value": "true",
      "note": "Fixes some broken graphics like water on Battleship Bay and potentially others."
    },
    {
      "id": "rpcs3.vertex_cache_off",
      "value": "true",
      "note": "Required to prevent severe graphical issues in some areas."
    }
  ],
  "patches": []
}
